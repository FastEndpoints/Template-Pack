<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <NoWarn>CS1591;CA2016;CS7022</NoWarn>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <DisableTestingPlatformServerCapability>true</DisableTestingPlatformServerCapability>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AWSSDK.SimpleEmailV2" Version="4.1.1"/>
        <PackageReference Include="BCrypt.Net-Next" Version="4.2.1"/>
        <PackageReference Include="FastEndpoints" Version="9.0.0"/>
        <PackageReference Include="FastEndpoints.Generator" Version="9.0.0" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive"/>
        <PackageReference Include="FastEndpoints.Security" Version="9.0.0"/>
        <PackageReference Include="FastEndpoints.OpenApi" Version="9.0.0"/>
        <PackageReference Include="LettuceEncrypt" Version="1.3.3"/>
        <PackageReference Include="MessagePack" Version="3.1.12"/>
        <PackageReference Include="MongoDB.Entities" Version="26.0.0"/>
    </ItemGroup>

    <!-- exclude test related code from release build -->
    <ItemGroup Condition="'$(Configuration)' != 'Release'">
        <PackageReference Include="FakeItEasy" Version="9.0.1"/>
        <PackageReference Include="FastEndpoints.Testing" Version="9.0.0"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0"/>
        <PackageReference Include="Shouldly" Version="4.3.0"/>
        <PackageReference Include="xunit.v3" Version="4.0.3"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <Content Update="Tests\xunit.runner.json" TargetPath="xunit.runner.json"/>
    </ItemGroup>
    <ItemGroup Condition="'$(Configuration)' == 'Release'">
        <Compile Remove="**\Tests\**"/>
        <Content Remove="**\Tests\**"/>
    </ItemGroup>
    <!-- exclude test related code from release build-->

    <PropertyGroup>
        <EnableSdkContainerSupport>true</EnableSdkContainerSupport>
        <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:11.0-alpine</ContainerBaseImage>
        <ContainerRegistry>sjc.vultrcr.com</ContainerRegistry>
        <ContainerRepository>MyProject/Api</ContainerRepository>
        <ContainerImageTag>latest</ContainerImageTag>
        <ContainerUser>root</ContainerUser>
        <InvariantGlobalization>true</InvariantGlobalization>
    </PropertyGroup>

</Project>