{
  "$schema": "http://json.schemastore.org/template",
  "author": "FastEndpoints",
  "classifications": [
    "FastEndpoints"
  ],
  "identity": "FastEndpoints.IntegratedStarter",
  "name": "FastEndpoints Starter Project Template With Integrated Testing",
  "shortName": "feintproj",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "MyProject",
  "preferNameDirectory": true,
  "symbols": {
    "reflectionCacheMethod": {
      "type": "generated",
      "generator": "regex",
      "replaces": "AddFromMyProject",
      "parameters": {
        "source": "name",
        "steps": [
          {
            "regex": "[^A-Za-z0-9]",
            "replacement": ""
          },
          {
            "regex": "^",
            "replacement": "AddFrom"
          }
        ]
      }
    },
    "projectFile": {
      "type": "generated",
      "generator": "regex",
      "replaces": "MyProject.csproj",
      "parameters": {
        "source": "name",
        "steps": [
          {
            "regex": "$",
            "replacement": ".csproj"
          }
        ]
      }
    },
    "databaseName": {
      "type": "generated",
      "generator": "regex",
      "replaces": "\"Name\": \"MyProject",
      "parameters": {
        "source": "name",
        "steps": [
          {
            "regex": "[^A-Za-z0-9_-]",
            "replacement": "_"
          },
          {
            "regex": "^",
            "replacement": "\"Name\": \""
          }
        ]
      }
    }
  }
}